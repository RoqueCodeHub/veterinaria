{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "landingangular": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/figtree/latin-600.css",
              "node_modules/@fontsource/figtree/latin-ext-600.css",
              "node_modules/@fontsource/figtree/latin-700.css",
              "node_modules/@fontsource/figtree/latin-ext-700.css",
              "node_modules/@fontsource/noto-sans/latin-400.css",
              "node_modules/@fontsource/noto-sans/latin-ext-400.css",
              "node_modules/@fontsource/noto-sans/latin-500.css",
              "node_modules/@fontsource/noto-sans/latin-ext-500.css",
              "node_modules/@fontsource/noto-sans/latin-600.css",
              "node_modules/@fontsource/noto-sans/latin-ext-600.css",
              "node_modules/@fontsource/noto-sans/latin-700.css",
              "node_modules/@fontsource/noto-sans/latin-ext-700.css",
              "node_modules/primeicons/primeicons.css",
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "landingangular:build:production"
            },
            "development": {
              "buildTarget": "landingangular:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
